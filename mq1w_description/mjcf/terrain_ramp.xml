<mujoco model="mq1w single_side_ramp scene">
  <include file="mq1w.xml"/>
  <statistic center="0 0 0.2" extent="1.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1600" offheight="1200"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <texture type="2d" name="terrain_tex" builtin="flat" rgb1="0.45 0.42 0.38" width="100" height="100"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="terrain_mat" texture="terrain_tex" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Ramp up -->
    <geom name="ramp_up" type="box" size="0.7524 0.1750 0.0400"
          pos="1.5500 0.2200 0.0600" euler="0 -4.57 0" material="terrain_mat"/>
    <!-- Plateau -->
    <geom name="plateau" type="box" size="0.6000 0.1750 0.0400"
          pos="2.9000 0.2200 0.0800" material="terrain_mat"/>
    <!-- Ramp down -->
    <geom name="ramp_down" type="box" size="0.7524 0.1750 0.0400"
          pos="4.2500 0.2200 0.0600" euler="0 4.57 0" material="terrain_mat"/>
  </worldbody>
</mujoco>
